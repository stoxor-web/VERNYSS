{
  "name": "private-finance-os-fr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage=false",
    "test:rules": "firebase emulators:exec --only firestore --project demo-private-finance-os \"vitest run tests/firestore\"",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:rules && npm run build",
    "audit": "npm audit --audit-level=high",
    "emulators": "firebase emulators:start --only auth,firestore,hosting",
    "news:fetch": "tsx scripts/news/runPipeline.ts",
    "check:secrets": "node scripts/security/checkSecrets.mjs"
  },
  "dependencies": {
    "firebase": "11.10.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "22.15.32",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.30.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "firebase-tools": "14.9.0",
    "globals": "16.2.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
